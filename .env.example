# Copy to .env and fill in. The real .env is gitignored — never commit it.

# --- required ---------------------------------------------------------------

# Bot token from https://discord.com/developers/applications
# This is the single most sensitive value here. It is never passed to a module: module
# processes are spawned with an empty environment.
DISCORD_TOKEN=

# Application ID from the same page.
DISCORD_APPLICATION_ID=

# --- signing ----------------------------------------------------------------

# base64 ed25519 public key for the module catalogue. Generate a keypair with:
#   npm run sign -- keygen
#
# Leave this blank and nothing can be verified, so EVERY module is treated as unsigned and
# every install shows the warning. That is the safe direction to fail, but it means you get no
# benefit from reviewing modules.
CATALOGUE_PUBLIC_KEY=

# Where the signed catalogue lives. Point this at your own if you self-host.
CATALOGUE_URL=https://anthonyf2312.github.io/modules.json

# --- intents ----------------------------------------------------------------

# Privileged intents to request, comma-separated: members, messageContent
#
# Empty by default and deliberately opt-in: Discord REFUSES THE LOGIN outright if you request
# a privileged intent that is not also enabled in the Developer Portal, so turning these on
# here without turning them on there produces a bot that cannot start.
#
#   members        — member join/leave events. Welcome modules need this.
#   messageContent — the text of messages. Moderation modules need this.
#
# Enable the matching toggles at:
#   Developer Portal → your app → Bot → Privileged Gateway Intents
PRIVILEGED_INTENTS=

# --- optional ---------------------------------------------------------------

# Comma-separated user IDs. Owners can install unlisted modules when installs are restricted.
OWNER_IDS=

# When true, only bot owners may install modules that are not in the catalogue.
# Leave false for the open policy: any admin with Manage Server can install any GitHub URL,
# with the unsigned warning as the guard.
RESTRICT_UNLISTED_INSTALLS=false

# GitHub personal access token. Needs no scopes — it only raises the API rate limit.
GITHUB_TOKEN=

# Where the database and module bundles live.
DATA_DIR=./data

LOG_LEVEL=info
NODE_ENV=development
