# Normalise text to LF in the repository.
* text=auto eol=lf

# These are consumed by Linux and break with CRLF — systemd refuses a unit file with carriage
# returns, and a shell script with them fails with a confusing "bad interpreter".
*.service text eol=lf
*.sh text eol=lf

# Binary
*.png binary
*.jpg binary
*.gz binary
*.key binary
